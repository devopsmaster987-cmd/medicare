{
  "name": "medicareclear",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env ALLOW_PLACEHOLDERS=1 npm run verify:data && npm run generate:llms && npm run generate:og && npm run generate:ads-txt && npm run verify:tokens && next build && npm run verify:og && npm run verify:seo && npm run verify:adsense && npm run verify:links && npm run verify:indexing",
    "start": "serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run verify:data && npm run verify:guides",
    "verify:data": "tsx scripts/verify-data.ts",
    "verify:guides": "tsx scripts/verify-guides.ts",
    "generate:llms": "tsx scripts/generate-llms.ts",
    "generate:og": "tsx scripts/generate-og.ts",
    "generate:ads-txt": "tsx scripts/generate-ads-txt.ts",
    "verify:og": "tsx scripts/verify-og.ts",
    "verify:seo": "tsx scripts/verify-seo.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "verify:tokens": "cross-env ALLOW_PLACEHOLDERS=1 tsx scripts/verify-tokens.ts",
    "verify:emails": "tsx scripts/verify-emails.ts",
    "verify:hardcode": "tsx scripts/verify-hardcode.ts",
    "verify:keywords": "tsx scripts/verify-keywords.ts",
    "verify:aeo": "tsx scripts/verify-aeo.ts",
    "verify:features": "tsx scripts/verify-features.ts",
    "verify:log": "tsx scripts/verify-log.ts",
    "verify:adsense": "tsx scripts/verify-adsense.ts",
    "check:all": "npm run verify && npm run verify:tokens && npm run verify:emails && npm run verify:hardcode && npm run verify:keywords && npm run verify:aeo && npm run verify:features && npm run verify:log && npm run verify:guides && npm run verify:adsense && npm run verify:links && npm run verify:a11y && npm run verify:indexing",
    "verify:indexing": "tsx scripts/verify-indexing.ts",
    "verify:links": "tsx scripts/verify-links.ts",
    "verify:a11y": "tsx scripts/verify-a11y.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.28",
    "clsx": "^2.1.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "serve": "^14.2.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
